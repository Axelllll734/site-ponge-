# Copier ce fichier en .env.local (développement) ou renseigner ces variables dans Vercel.
# Ne jamais committer de vraies valeurs.

# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# --- Shopify (Storefront API) — active le paiement sécurisé ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
# Identifiants des variantes Shopify (gid://shopify/ProductVariant/…)
SHOPIFY_VARIANT_LOT_1=
SHOPIFY_VARIANT_LOT_2=
SHOPIFY_VARIANT_LOT_3=
SHOPIFY_VARIANT_LOT_5=

# --- Formulaires (contact, professionnels) via Resend ---
RESEND_API_KEY=
FORMS_TO_EMAIL=
FORMS_FROM_EMAIL="CHEBKA <site@exemple.fr>"
